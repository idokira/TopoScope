      },
      {
        "type": "Module",
        "name": "led_driver",
        "description": "PT4115-based high-power LED constant-current buck driver operating directly from the external VIN_12V_24V rail and regulating approximately 350 mA LED current. This module is the power conversion and current-control core: it switches energy at SW, senses regulated LED current through CSN via an external current-sense network, and accepts optional brightness control at DIM. The controlled power path is from VIN_12V_24V through the switching stage to the LED load and back through the current-sense path to GND. DIM should be planned so the driver can be enabled or PWM/analog dimmed; if no external controller is present, downstream implementation must define the default DIM bias needed for always-on operation. EP must be tied into the ground/thermal system. High-current LED loop and current-sense return should be kept tightly associated in later wiring to preserve regulation accuracy and switching performance.",
        "id": "led_driver"
      },
      {
        "type": "Component",
        "refdes": "U1",
        "part_number": "PT4115",
        "description": "High-power LED constant-current driver",
        "id": "U1"
      },
      {
        "type": "Pin",
        "name": "SW",
        "pin_number": "1",
        "electrical_type": "PowerOut",
        "description": "Drain of internal N-Ch MOSFET power switch. When ON, SW is pulled to GND internally. Connects to inductor and freewheeling diode anode.",
        "id": "U1_Pin1"
      },
      {
        "type": "Pin",
        "name": "GND",
        "pin_number": "2",
        "electrical_type": "Ground",
        "description": "Power and signal ground. Connect directly to ground plane.",
        "id": "U1_Pin2"
      },
      {
        "type": "Pin",
        "name": "DIM",
        "pin_number": "3",
        "electrical_type": "Input",
        "description": "Dimming control input. Internal 1.2M pull-up to 5V, can float for always-on. DC 0.5-2.5V for analog dimming. Below 0.3V forces shutdown (60uA quiescent). PWM dimming 100Hz-20kHz supported.",
        "id": "U1_Pin3"
      },
      {
        "type": "Pin",
        "name": "CSN",
        "pin_number": "4",
        "electrical_type": "AnalogIn",
        "description": "High-side current sense input. Connect sense resistor between VIN and CSN. IC measures (VIN - VCSN) to regulate LED current. ILED = 100mV / Rs.",
        "id": "U1_Pin4"
      },
      {
        "type": "Pin",
        "name": "VIN",
        "pin_number": "5",
        "electrical_type": "PowerIn",
        "description": "Power supply input, 6V to 30V. Requires low-ESR bypass capacitor (>=4.7uF).",
        "id": "U1_Pin5"
      },
      {
        "type": "Pin",
        "name": "EP",
        "pin_number": "PAD",
        "electrical_type": "Ground",
        "description": "Exposed thermal pad, internally connected to GND. Must be soldered to PCB ground plane for thermal dissipation.",
        "id": "U1_PinPAD"
      },
      {
        "type": "Module",
        "name": "led_load",
        "description": "External 1W LED load interface representing the driven emitter. It receives controlled drive current from the LED driver at the anode side and returns current from the cathode side into the driver current-sense path. The LED forward-voltage operating point is not generated here; this module only exposes the required load terminals so the regulated 350 mA current path remains explicit for downstream wiring. Thermal handling of the LED itself is outside this schematic-planning phase but the current path through this module is mandatory.",
        "id": "led_load"
      },
      {
        "type": "Module",
        "name": "dimming_interface",
        "description": "External dimming/control interface for the PT4115 DIM input. This module represents whatever off-board or later-defined control source sets LED enable or brightness. No active controller is provided in the component list, so this interface only captures the routing intent into DIM and does not assume a specific waveform source, logic level generator, or autonomous control policy beyond the need for a valid DIM bias in the final design.",
        "id": "dimming_interface"
