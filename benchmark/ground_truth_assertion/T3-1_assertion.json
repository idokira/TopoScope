        {
          "check": "SAME_NET",
          "params": {
            "pins": [
              "U3.VDDA",
              "U3.VREF_P",
              "U6.VCC"
            ]
          }
        }
      ]
    },
    {
      "id": "T3-1-ANY-003",
      "type": "ANY_OF",
      "desc": "W25Q128JV WP must be held inactive for normal Standard SPI operation: either directly tied high or pulled up to power.",
      "conditions": [
        {
          "check": "SAME_NET",
          "params": {
