      {
        "type": "Module",
        "name": "power_5v",
        "description": "TPS54331 buck converter steps VIN_12V down to VCC_5V. BOOT pin requires bootstrap capacitor connected to PH node. EN pin tied to VIN for always-on operation. SS pin requires soft-start capacitor to GND. VSENSE pin connects to VCC_5V output via feedback voltage divider for 5V regulation setpoint. COMP pin requires external RC compensation network for loop stability. PH pin is the switching node connecting to output inductor; freewheeling Schottky diode connects from PH to GND.",
        "id": "power_5v"
      },
