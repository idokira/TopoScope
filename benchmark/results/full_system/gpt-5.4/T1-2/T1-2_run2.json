      {
        "type": "Module",
        "name": "power_3v3",
        "description": "AMS1117-3.3 linear regulator converts the external VIN_5V rail into the regulated VCC_3V3 output rail. This module is the sole provider of the internally generated 3.3V rail and serves as the source for downstream distribution and supervision. The regulator uses VIN and GND as its supply domain and exposes VCC_3V3 for consumers. Output stability and regulator support components are added downstream; this module owns the generated rail but not any separate control interface.",
        "id": "power_3v3"
      },
