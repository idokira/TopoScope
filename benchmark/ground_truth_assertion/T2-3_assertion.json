    {
      "id": "T2-3-T06-003",
      "check": "HAS_PULLUP_TO_POWER",
      "desc": "I2C SCL line requires external pull-up resistor to power.",
      "params": {
        "pin": "U3.PC2"
      }
    },
    {
      "id": "T2-3-T01-001",
      "check": "HAS_CAP_TO_GROUND",
      "desc": "LDO input rail (VIN) must have bypass capacitor to ground.",
      "params": {
        "pin": "U1.VIN"
      }
    },
    {
      "id": "T2-3-T01-002",
      "check": "HAS_CAP_TO_GROUND",
      "desc": "3.3V domain must have decoupling capacitor to ground. One T01 covers the unified rail.",
      "params": {
