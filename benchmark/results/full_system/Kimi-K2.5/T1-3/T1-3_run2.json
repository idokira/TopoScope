      },
      {
        "type": "Module",
        "name": "led_driver",
        "description": "PT4115 high-power LED constant-current buck driver. Converts VIN_12_24V to regulated LED current. SW pin drives external inductor and Schottky diode for buck topology. CSN pin senses LED current via external sense resistor to set 350mA constant current. DIM pin accepts analog/PWM dimming control (0-2.5V range, 0-100% duty). EP pad is thermal and electrical ground, requires thermal vias to copper pour. LED cathode connects to CSN sense node, LED anode to inductor/diode junction. No enable pin; driver operates when VIN present.",
        "id": "led_driver"
      },
      {
        "type": "Component",
        "refdes": "U1",
        "part_number": "PT4115",
        "description": "High-power LED constant-current driver",
        "id": "U1"
      },
      {
        "type": "Pin",
        "name": "SW",
        "pin_number": "1",
        "electrical_type": "PowerOut",
        "description": "Drain of internal N-Ch MOSFET power switch. When ON, SW is pulled to GND internally. Connects to inductor and freewheeling diode anode.",
        "id": "U1_Pin1"
      },
      {
        "type": "Pin",
        "name": "GND",
        "pin_number": "2",
        "electrical_type": "Ground",
        "description": "Power and signal ground. Connect directly to ground plane.",
        "id": "U1_Pin2"
      },
      {
        "type": "Pin",
        "name": "DIM",
        "pin_number": "3",
        "electrical_type": "Input",
        "description": "Dimming control input. Internal 1.2M pull-up to 5V, can float for always-on. DC 0.5-2.5V for analog dimming. Below 0.3V forces shutdown (60uA quiescent). PWM dimming 100Hz-20kHz supported.",
        "id": "U1_Pin3"
      },
      {
        "type": "Pin",
        "name": "CSN",
        "pin_number": "4",
        "electrical_type": "AnalogIn",
        "description": "High-side current sense input. Connect sense resistor between VIN and CSN. IC measures (VIN - VCSN) to regulate LED current. ILED = 100mV / Rs.",
        "id": "U1_Pin4"
      },
      {
        "type": "Pin",
        "name": "VIN",
        "pin_number": "5",
        "electrical_type": "PowerIn",
        "description": "Power supply input, 6V to 30V. Requires low-ESR bypass capacitor (>=4.7uF).",
        "id": "U1_Pin5"
      },
      {
        "type": "Pin",
        "name": "EP",
        "pin_number": "PAD",
        "electrical_type": "Ground",
        "description": "Exposed thermal pad, internally connected to GND. Must be soldered to PCB ground plane for thermal dissipation.",
        "id": "U1_PinPAD"
      },
      {
        "type": "Module",
        "name": "dimming_source",
        "description": "Dimming control source for PT4115. Provides 0-2.5V analog voltage or PWM signal to DIM pin for brightness control. Can be potentiometer divider, MCU DAC/PWM, or fixed voltage for full brightness. This module represents the external control interface; actual implementation may be fixed resistor divider for constant brightness or connector for external control.",
        "id": "dimming_source"
      },
      {
        "type": "Module",
        "name": "led_load",
        "description": "1W LED load with 350mA nominal current. LED anode receives switched power from driver inductor/diode node. LED cathode connects to current sense resistor which ties to ground, with CSN tap at cathode for feedback. Forward voltage approximately 3V at 350mA. Thermal management required for 1W dissipation.",
        "id": "led_load"
      },
