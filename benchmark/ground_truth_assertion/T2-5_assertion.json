    {
      "id": "T2-5-I01-001",
      "check": "NOT_SAME_NET",
      "desc": "BOOT0 must not be tied to VDD; forces bootloader mode instead of normal flash boot.",
      "params": {
        "pins": [
          "U2.BOOT0",
          "U2.VDD_1"
        ]
      }
    },
    {
      "id": "T2-5-ANY-001",
      "type": "ANY_OF",
      "desc": "BOOT0 grounding policy: direct tie to GND or pull-down resistor to GND.",
      "conditions": [
        {
          "check": "SAME_NET",
          "params": {
            "pins": [
              "U2.BOOT0",
              "U2.VSS_1"
            ]
          }
        },
        {
          "check": "EXISTS_PATH",
          "params": {
            "from_pin": "U2.BOOT0",
            "destination": "U2.VSS_1",
            "max_hops": 6,
            "allowed_components": [
              "Resistor"
            ]
          }
        }
      ]
    },
    {
      "id": "T2-5-ANY-002",
      "type": "ANY_OF",
      "desc": "Flash WP must be inactive: direct tie to VDD or pull-up to power.",
      "conditions": [
        {
          "check": "SAME_NET",
          "params": {
            "pins": [
              "U4.WP",
              "U1.VOUT"
            ]
          }
        },
        {
          "check": "HAS_PULLUP_TO_POWER",
          "params": {
            "pin": "U4.WP"
          }
        }
      ]
    },
    {
      "id": "T2-5-ANY-003",
      "type": "ANY_OF",
      "desc": "Flash HOLD must be inactive: direct tie to VDD or pull-up to power.",
      "conditions": [
        {
          "check": "SAME_NET",
          "params": {
            "pins": [
              "U4.HOLD",
              "U1.VOUT"
            ]
          }
        },
        {
          "check": "HAS_PULLUP_TO_POWER",
          "params": {
            "pin": "U4.HOLD"
          }
        }
      ]
    },
    {
      "id": "T2-5-T11-001",
      "check": "HAS_BUS_TERMINATION",
      "desc": "RS485 differential bus requires 120ohm termination resistor between A and B.",
      "params": {
        "pin_p": "U3.A",
        "pin_n": "U3.B",
        "resistance_range": "100-140"
      }
    },
    {
      "id": "T2-5-T12-001",
      "check": "HAS_DECOUPLING_NETWORK",
      "desc": "GD32 NRST requires RC reset topology: pull-up resistor to power plus filter capacitor to ground.",
      "params": {
        "pin": "U2.NRST",
        "require_pullup_to_power": true,
        "require_cap_to_ground": true
      }
    },
    {
      "id": "T2-5-T05-001",
      "check": "HAS_CRYSTAL_PAIR",
      "desc": "GD32 8MHz crystal on OSCIN/OSCOUT with load capacitors to ground.",
      "params": {
        "pin_osc_in": "U2.OSCIN",
        "pin_osc_out": "U2.OSCOUT"
      }
    },
    {
      "id": "T2-5-T01-001",
      "check": "HAS_CAP_TO_GROUND",
      "desc": "LDO input rail (VIN) must have bypass capacitor to ground.",
      "params": {
        "pin": "U1.VIN"
      }
    },
    {
      "id": "T2-5-T01-002",
      "check": "HAS_CAP_TO_GROUND",
      "desc": "3.3V domain must have decoupling capacitor to ground. One T01 covers the unified rail.",
