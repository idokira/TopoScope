            "U6.CS"
          ]
        ]
      }
    },
    {
      "id": "T3-1-ANY-001",
      "type": "ANY_OF",
      "desc": "MPU-6050 AD0 must select a valid I2C address: GND for 0x68 or VDD for 0x69.",
      "conditions": [
