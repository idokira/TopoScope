{
  "design_id": "T2-5",
  "tier": 2,
  "type": "COM",
  "description": "RS485 Modbus node. GD32F103 communicates on RS485 bus via SP3485 half-duplex transceiver. USART0 TX/RX may use the default or remapped hardware pin pair; DE/RE are tied together on PA1 for direction control. W25Q128JV SPI Flash uses GD32F103 SPI0, either default or remapped pin bundle. AMS1117-3.3 provides 3.3V from 5V. 120ohm bus termination on RS485 A/B. GD32F103 uses OSCIN/OSCOUT naming for crystal pins.",
  "ic_list": [
    "AMS1117-3.3 (U1)",
    "GD32F103xx (U2)",
    "SP3485 (U3)",
    "W25Q128JV (U4)"
  ],
  "verification_assertions": [
    {
      "id": "T2-5-C01-001",
      "check": "SAME_NET",
      "desc": "GND unification: all ground pins across 4 ICs share one common ground net.",
      "params": {
        "pins": [
          "U1.ADJ",
          "U2.VSS_1",
          "U2.VSS_2",
          "U2.VSS_3",
          "U2.VSSA",
          "U3.GND",
          "U4.GND"
        ]
      }
    },
    {
      "id": "T2-5-C01-002",
      "check": "SAME_NET",
      "desc": "3.3V domain unification: LDO output, MCU core/analog/battery supply, RS485 transceiver VCC, and Flash VCC share one power net.",
      "params": {
        "pins": [
          "U1.VOUT",
          "U2.VDD_1",
          "U2.VDD_2",
          "U2.VDD_3",
          "U2.VDDA",
          "U2.VBAT",
          "U3.VCC",
          "U4.VCC"
        ]
      }
    },
    {
      "id": "T2-5-I02-001",
      "check": "NET_GROUP_ISOLATION",
      "desc": "Critical pin isolation: GND, VCC, VIN, UART TX, UART RX, DE/RE control, SPI SCK/MOSI/MISO/CS, RS485 A/B, crystal (OSCIN/OSCOUT), and NRST must all be on mutually distinct nets. Bus-related isolation is anchored on transceiver/flash-side pins so it is invariant to GD32F103 default/remap selection.",
      "params": {
        "groups": [
          [
            "U1.ADJ"
          ],
          [
            "U1.VOUT"
          ],
          [
            "U1.VIN"
          ],
          [
            "U3.DI"
          ],
          [
            "U3.RO"
          ],
          [
            "U3.DE"
          ],
          [
            "U4.CLK"
          ],
          [
            "U4.DI"
          ],
          [
            "U4.DO"
          ],
          [
            "U4.CS"
          ],
          [
            "U3.A"
          ],
          [
            "U3.B"
          ],
          [
            "U2.OSCIN"
          ],
          [
            "U2.OSCOUT"
          ],
          [
            "U2.NRST"
          ]
        ]
      }
    },
    {
      "id": "T2-5-C02-001",
      "check": "CONNECTED_TO_GROUND",
      "desc": "Unified ground net must carry Ground electrical attribute.",
      "params": {
        "pin": "U1.ADJ"
      }
    },
    {
      "id": "T2-5-C03-001",
      "check": "CONNECTED_TO_POWER",
      "desc": "3.3V rail must carry Power electrical attribute.",
      "params": {
        "pin": "U1.VOUT"
      }
    },
    {
      "id": "T2-5-C03-002",
      "check": "CONNECTED_TO_POWER",
      "desc": "5V input rail must carry Power electrical attribute.",
      "params": {
        "pin": "U1.VIN"
      }
    },
    {
      "id": "T2-5-C01-003",
      "check": "SAME_NET",
      "desc": "UART legal bundle mapping: accept one complete legal GD32F103 USART0 TX/RX pair to the SP3485 DI/RO pins, either default pins or remapped pins. This forbids illegal mixed mappings such as PA9 for TX together with PB7 for RX.",
      "params": {
        "net_group_candidates": [
          {
            "label": "USART0_DEFAULT",
            "pin_groups_list": [
              [
