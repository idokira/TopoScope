                ]
              ]
            ]
          }
        ]
      }
    },
    {
      "id": "T2-5-C01-005",
      "check": "SAME_NET",
      "desc": "Half-duplex direction control: one legal GD32F103 control GPIO is tied to both SP3485 DE and RE for TX/RX switching.",
      "params": {
        "pin_groups": [
          [
            "U2.PA0",
