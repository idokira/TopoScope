    },
    {
      "id": "T3-1-ANY-004",
      "type": "ANY_OF",
      "desc": "W25Q128JV HOLD must be held inactive for normal Standard SPI operation: either directly tied high or pulled up to power.",
      "conditions": [
        {
          "check": "SAME_NET",
          "params": {
            "pins": [
              "U6.HOLD",
              "U6.VCC"
            ]
