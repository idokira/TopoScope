      {
        "type": "Module",
        "name": "power_3v3",
        "description": "AMS1117-3.3 linear regulator converts the external VIN_5V rail into the regulated VCC_3V3 rail. This module is the sole provider of the internally generated 3.3V rail and distributes that rail to downstream consumers. The regulator operates as a fixed 3.3V output stage using its VIN, VOUT, and GND pins only; required input/output stabilization and decoupling are implemented later as local support circuitry. The generated VCC_3V3 rail is also the rail monitored by the supervisor, so the output node must be the common regulated distribution point seen by both loads and the monitor path.",
        "id": "power_3v3"
      },
      {
        "type": "Component",
        "refdes": "U1",
        "part_number": "AMS1117-3.3",
        "description": "1A fixed 3.3V LDO regulator",
