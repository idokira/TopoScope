      {
        "type": "Module",
        "name": "rs485_transceiver",
        "description": "SP3485 converts the MCU UART logic interface to the differential RS485 bus for Modbus communication. It consumes VCC_3V3 and GND, accepts MCU transmit data on DI, returns received data on RO, and uses separate RE and DE control inputs from the MCU to manage receive/transmit direction policy. The external bus side is exposed as RS485_A and RS485_B. Any required bus termination, fail-safe biasing, and connector-side protection are implemented later as passive or protection networks; this module preserves the routing intent to the differential bus without assuming those parts are built into the IC.",
        "id": "rs485_transceiver"
      },
      {
        "type": "Component",
        "refdes": "U3",
        "part_number": "SP3485",
        "description": "3.3V RS485 transceiver",
        "id": "U3"
      },
      {
        "type": "Pin",
        "name": "RO",
        "pin_number": "1",
        "electrical_type": "Output",
        "description": "Receiver output, digital logic level",
        "id": "U3_Pin1"
      },
      {
        "type": "Pin",
