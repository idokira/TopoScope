          "check": "CONNECTED_TO_POWER",
          "params": {
            "pin": "U4.AD0"
          }
        }
      ]
    },
    {
      "id": "T3-1-ANY-002",
      "type": "ANY_OF",
      "desc": "STM32F427 analog supply/reference-positive may either join the dedicated analog/sensor rail or remain on the digital 3.3V rail, but VDDA and VREF_P must be implemented consistently together.",
      "conditions": [
        {
          "check": "SAME_NET",
          "params": {
