      {
        "type": "Module",
        "name": "led_driver",
        "description": "PT4115 LED constant-current driver module. Input from VIN_12V rail (12V-24V). Output switched inductor node (SW pin) connects to LED load via external series inductor and LED. Current sense resistor (external) connected between CSN pin and GND sets LED current to 350mA; VCSN must be monitored. Dimming input (DIM) can accept external PWM or DC voltage to adjust LED brightness; if unused, DIM must be pulled to VIN_12V for full brightness. Exposed power pad (EP) must be thermally grounded.",
        "id": "led_driver"
      },
      {
        "type": "Component",
        "refdes": "U1",
        "part_number": "PT4115",
        "description": "High-power LED constant-current driver",
        "id": "U1"
      },
      {
        "type": "Pin",
        "name": "SW",
        "pin_number": "1",
        "electrical_type": "PowerOut",
        "description": "Drain of internal N-Ch MOSFET power switch. When ON, SW is pulled to GND internally. Connects to inductor and freewheeling diode anode.",
        "id": "U1_Pin1"
      },
      {
        "type": "Pin",
        "name": "GND",
        "pin_number": "2",
        "electrical_type": "Ground",
        "description": "Power and signal ground. Connect directly to ground plane.",
        "id": "U1_Pin2"
      },
      {
        "type": "Pin",
        "name": "DIM",
        "pin_number": "3",
        "electrical_type": "Input",
        "description": "Dimming control input. Internal 1.2M pull-up to 5V, can float for always-on. DC 0.5-2.5V for analog dimming. Below 0.3V forces shutdown (60uA quiescent). PWM dimming 100Hz-20kHz supported.",
        "id": "U1_Pin3"
      },
      {
        "type": "Pin",
        "name": "CSN",
        "pin_number": "4",
        "electrical_type": "AnalogIn",
        "description": "High-side current sense input. Connect sense resistor between VIN and CSN. IC measures (VIN - VCSN) to regulate LED current. ILED = 100mV / Rs.",
        "id": "U1_Pin4"
      },
      {
        "type": "Pin",
        "name": "VIN",
        "pin_number": "5",
        "electrical_type": "PowerIn",
        "description": "Power supply input, 6V to 30V. Requires low-ESR bypass capacitor (>=4.7uF).",
        "id": "U1_Pin5"
      },
      {
        "type": "Pin",
        "name": "EP",
        "pin_number": "PAD",
        "electrical_type": "Ground",
        "description": "Exposed thermal pad, internally connected to GND. Must be soldered to PCB ground plane for thermal dissipation.",
        "id": "U1_PinPAD"
      },
      {
        "type": "Module",
        "name": "led_load",
        "description": "1W LED load and external inductor. LED is driven via the switched inductor node from driver. Load's anode connects to LED_SW. Load's cathode returns to common GND. External inductor required between LED_SW and VIN_12V; inductor selection and placement performed downstream. LED forward voltage and current path defined by driver's CSN sense resistor setting.",
        "id": "led_load"
      },
      {
        "type": "Module",
        "name": "dimming_interface",
        "description": "External dimming source (if used). Provides PWM or DC voltage to DIM_IN pin of driver. If not implemented, this module may be omitted and DIM_IN must be pulled high via resistor to VIN_12V for full brightness. Signal must be level-compatible with driver's DIM pin range (0-2.5V typical).",
        "id": "dimming_interface"
      },
      {
        "type": "Module",
        "name": "current_sense_network",
        "description": "External current sense resistor network for LED driver. Sense resistor placed between driver CSN pin and system GND to set LED current to 350mA. This module owns the low-side shunt connection point (driver CSN) and provides feedback to driver's CSN pin. Sense resistor value is downstream-selected according to PT4115 VCSN threshold.",
        "id": "current_sense_network"
      },
