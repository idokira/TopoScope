        ],
        "id": "VIN_12V_24V"
      },
      {
        "type": "Module",
        "name": "led_driver",
        "description": "PT4115-based high-power LED constant-current buck driver operating directly from the external VIN_12V_24V rail to drive a 1W LED load at a target current of 350mA. This module owns the power-switching, current regulation, and dimming-control domain. SW is the switching node that routes energy through the external inductor/diode path to the LED output chain, CSN is the current-sense feedback input that must observe the LED current through an external sense resistor network referenced to ground, and DIM is the control input used for enable/PWM or analog dimming policy if that function is brought out; if no external controller is present, DIM must be biased for the intended always-on operating mode by downstream implementation. The LED current path and the CSN feedback path are tightly coupled and must be planned together so the regulator senses the actual load current. High-current switching and sense-return routing should preserve a clean current-sense reference even though all circuitry shares the single GND net.",
        "id": "led_driver"
      },
      {
        "type": "Component",
        "refdes": "U1",
        "part_number": "PT4115",
        "description": "High-power LED constant-current driver",
        "id": "U1"
      },
      {
        "type": "Pin",
        "name": "SW",
        "pin_number": "1",
        "electrical_type": "PowerOut",
        "description": "Drain of internal N-Ch MOSFET power switch. When ON, SW is pulled to GND internally. Connects to inductor and freewheeling diode anode.",
        "id": "U1_Pin1"
      },
      {
        "type": "Pin",
        "name": "GND",
        "pin_number": "2",
        "electrical_type": "Ground",
        "description": "Power and signal ground. Connect directly to ground plane.",
        "id": "U1_Pin2"
      },
      {
        "type": "Pin",
        "name": "DIM",
        "pin_number": "3",
        "electrical_type": "Input",
        "description": "Dimming control input. Internal 1.2M pull-up to 5V, can float for always-on. DC 0.5-2.5V for analog dimming. Below 0.3V forces shutdown (60uA quiescent). PWM dimming 100Hz-20kHz supported.",
        "id": "U1_Pin3"
      },
      {
        "type": "Pin",
        "name": "CSN",
        "pin_number": "4",
        "electrical_type": "AnalogIn",
        "description": "High-side current sense input. Connect sense resistor between VIN and CSN. IC measures (VIN - VCSN) to regulate LED current. ILED = 100mV / Rs.",
        "id": "U1_Pin4"
      },
      {
        "type": "Pin",
        "name": "VIN",
        "pin_number": "5",
        "electrical_type": "PowerIn",
        "description": "Power supply input, 6V to 30V. Requires low-ESR bypass capacitor (>=4.7uF).",
        "id": "U1_Pin5"
      },
      {
        "type": "Pin",
        "name": "EP",
        "pin_number": "PAD",
        "electrical_type": "Ground",
        "description": "Exposed thermal pad, internally connected to GND. Must be soldered to PCB ground plane for thermal dissipation.",
        "id": "U1_PinPAD"
      },
      {
        "type": "Module",
        "name": "led_load",
        "description": "External 1W LED load domain representing the driven high-power LED string endpoint for this design brief. The LED anode receives regulated switched current from the PT4115 power stage, and the LED cathode returns through the external current-sense element to ground so the driver can regulate 350mA. This module exists to keep the load path explicit at macro level even though the LED device itself is not present in the provided component list. The implementation depends on a passive current-sense resistor between the LED cathode-side sense node and GND; no active load-side conditioning is assumed.",
        "id": "led_load"
      },
