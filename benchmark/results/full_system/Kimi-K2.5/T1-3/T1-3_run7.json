      {
        "type": "Module",
        "name": "led_driver",
        "description": "PT4115 buck LED driver. Converts VIN_12_24V to constant 350mA current for 1W LED. SW pin drives external inductor and freewheeling diode (passives added downstream). CSN pin senses current via external resistor (added downstream). DIM pin accepts analog/PWM dimming control; tied to VIN for full brightness if no dimming source provided. GND is power ground; EP is thermal pad requiring ground connection. Input needs bypass capacitor and reverse polarity protection (added downstream).",
        "id": "led_driver"
      },
      {
        "type": "Component",
        "refdes": "U1",
        "part_number": "PT4115",
        "description": "High-power LED constant-current driver",
        "id": "U1"
      },
      {
        "type": "Pin",
        "name": "SW",
        "pin_number": "1",
        "electrical_type": "PowerOut",
        "description": "Drain of internal N-Ch MOSFET power switch. When ON, SW is pulled to GND internally. Connects to inductor and freewheeling diode anode.",
        "id": "U1_Pin1"
      },
      {
        "type": "Pin",
        "name": "GND",
        "pin_number": "2",
        "electrical_type": "Ground",
        "description": "Power and signal ground. Connect directly to ground plane.",
        "id": "U1_Pin2"
      },
      {
        "type": "Pin",
        "name": "DIM",
        "pin_number": "3",
        "electrical_type": "Input",
        "description": "Dimming control input. Internal 1.2M pull-up to 5V, can float for always-on. DC 0.5-2.5V for analog dimming. Below 0.3V forces shutdown (60uA quiescent). PWM dimming 100Hz-20kHz supported.",
        "id": "U1_Pin3"
      },
      {
        "type": "Pin",
        "name": "CSN",
        "pin_number": "4",
        "electrical_type": "AnalogIn",
        "description": "High-side current sense input. Connect sense resistor between VIN and CSN. IC measures (VIN - VCSN) to regulate LED current. ILED = 100mV / Rs.",
        "id": "U1_Pin4"
      },
      {
        "type": "Pin",
        "name": "VIN",
        "pin_number": "5",
        "electrical_type": "PowerIn",
        "description": "Power supply input, 6V to 30V. Requires low-ESR bypass capacitor (>=4.7uF).",
        "id": "U1_Pin5"
      },
      {
        "type": "Pin",
        "name": "EP",
        "pin_number": "PAD",
        "electrical_type": "Ground",
        "description": "Exposed thermal pad, internally connected to GND. Must be soldered to PCB ground plane for thermal dissipation.",
        "id": "U1_PinPAD"
      },
      {
        "type": "Module",
        "name": "led_load",
        "description": "1W LED load driven at 350mA constant current. Anode connects to VIN_12_24V through inductor/diode network (passives added downstream). Cathode returns to LED_CATHODE port of driver. Current flows from VIN through LED to SW node via external inductor, with recirculation through freewheeling diode.",
        "id": "led_load"
      },
      {
        "type": "Module",
        "name": "dimming_source",
        "description": "Optional dimming control source for PT4115 DIM pin. Can be analog voltage 0-2.5V or PWM signal. If unused, DIM is pulled to VIN for 100% brightness. This module represents external dimming interface or internal pull-up configuration intent.",
        "id": "dimming_source"
