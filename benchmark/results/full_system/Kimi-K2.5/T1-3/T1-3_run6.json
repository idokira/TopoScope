      },
      {
        "type": "Module",
        "name": "led_driver",
        "description": "PT4115 buck LED constant-current driver. Converts VIN_12_24V to regulated LED current. SW pin drives external inductor and freewheeling diode to LED cathode. CSN pin senses LED current via external sense resistor to set 350mA constant current. DIM pin accepts PWM or analog dimming control; pulled up to internal supply for full brightness if unused. GND is power ground. EP (exposed pad) is thermal ground requiring copper pour connection. The LED anode connects to VIN_12_24V directly. Current sense resistor between LED cathode and CSN sets output current.",
        "id": "led_driver"
      },
      {
        "type": "Component",
        "refdes": "U1",
        "part_number": "PT4115",
        "description": "High-power LED constant-current driver",
        "id": "U1"
      },
      {
        "type": "Pin",
        "name": "SW",
        "pin_number": "1",
        "electrical_type": "PowerOut",
        "description": "Drain of internal N-Ch MOSFET power switch. When ON, SW is pulled to GND internally. Connects to inductor and freewheeling diode anode.",
        "id": "U1_Pin1"
      },
      {
        "type": "Pin",
        "name": "GND",
        "pin_number": "2",
        "electrical_type": "Ground",
        "description": "Power and signal ground. Connect directly to ground plane.",
        "id": "U1_Pin2"
      },
      {
        "type": "Pin",
        "name": "DIM",
        "pin_number": "3",
        "electrical_type": "Input",
        "description": "Dimming control input. Internal 1.2M pull-up to 5V, can float for always-on. DC 0.5-2.5V for analog dimming. Below 0.3V forces shutdown (60uA quiescent). PWM dimming 100Hz-20kHz supported.",
        "id": "U1_Pin3"
      },
      {
        "type": "Pin",
        "name": "CSN",
        "pin_number": "4",
        "electrical_type": "AnalogIn",
        "description": "High-side current sense input. Connect sense resistor between VIN and CSN. IC measures (VIN - VCSN) to regulate LED current. ILED = 100mV / Rs.",
        "id": "U1_Pin4"
      },
      {
        "type": "Pin",
        "name": "VIN",
        "pin_number": "5",
        "electrical_type": "PowerIn",
        "description": "Power supply input, 6V to 30V. Requires low-ESR bypass capacitor (>=4.7uF).",
        "id": "U1_Pin5"
      },
      {
        "type": "Pin",
        "name": "EP",
        "pin_number": "PAD",
        "electrical_type": "Ground",
        "description": "Exposed thermal pad, internally connected to GND. Must be soldered to PCB ground plane for thermal dissipation.",
        "id": "U1_PinPAD"
      },
      {
        "type": "Module",
        "name": "led_load",
        "description": "1W LED load at 350mA. Anode connects to VIN_12_24V. Cathode connects to driver switching node via inductor/diode network, with current sense path to driver CSN pin. Thermal management required for LED junction temperature.",
        "id": "led_load"
      },
      {
        "type": "Module",
        "name": "dimming_interface",
        "description": "External dimming control interface for PT4115 DIM pin. Can be left open (pulled up internally for full brightness) or driven by external PWM/analog source. If unused, no external connection needed.",
        "id": "dimming_interface"
