{
  "design_id": "T3-1",
  "tier": 3,
  "type": "SEN",
  "description": "Flight controller core board. A 5V input feeds TPS54331 to generate a 3.3V digital rail and ME6211 to generate a separate 3.3V analog/sensor rail. STM32F427 connects to MPU-6050 IMU via I2C, and to BMP280 barometer plus W25Q128JV black-box Flash via shared SPI with separate chip-select signals. Common GND is used with analog/digital star-ground intent. The digital 3.3V and analog/sensor 3.3V rails must remain distinct, but grounds are not galvanically isolated.",
  "ic_list": [
    "TPS54331 (U1)",
    "ME6211 (U2)",
    "STM32F427 (U3)",
    "MPU-6050 (U4)",
    "BMP280 (U5)",
    "W25Q128JV (U6)"
  ],
  "verification_assertions": [
    {
      "id": "T3-1-C01-001",
      "check": "SAME_NET",
      "desc": "Common ground: power regulators, STM32 grounds/reference-negative, IMU ground, barometer grounds, and flash ground share one common GND with star-ground layout intent.",
      "params": {
        "pins": [
          "U1.GND",
          "U2.VSS",
          "U3.VSS_1",
          "U3.VSS_2",
          "U3.VSS_3",
          "U3.VSSA",
          "U3.VREF_N",
          "U4.GND",
          "U5.GND_1",
          "U5.GND_2",
          "U6.GND"
        ]
      }
    },
    {
      "id": "T3-1-C01-002",
      "check": "SAME_NET",
      "desc": "5V input rail feeds both the TPS54331 digital buck input and the ME6211 analog/sensor LDO input.",
      "params": {
        "pins": [
          "U1.VIN",
          "U2.VIN"
        ]
      }
    },
    {
      "id": "T3-1-C01-003",
      "check": "SAME_NET",
      "desc": "3.3V digital rail powers STM32F427 digital VDD pins, USB supply pin, backup domain, and W25Q128JV flash VCC.",
      "params": {
        "pins": [
          "U3.VDD_1",
          "U3.VDD_2",
          "U3.VDD_3",
          "U3.VDD_4",
          "U3.VDD_USB",
          "U3.VBAT",
          "U6.VCC"
        ]
      }
    },
    {
      "id": "T3-1-C01-004",
      "check": "SAME_NET",
      "desc": "Core analog/sensor rail: ME6211 output powers the motion/barometer sensor supplies. This captures the separate sensor rail requirement without over-constraining STM32 analog-domain implementation details.",
      "params": {
        "pins": [
          "U2.VOUT",
          "U4.VDD",
          "U5.VDD",
          "U5.VDDIO"
        ]
      }
    },
    {
      "id": "T3-1-C01-005",
      "check": "SAME_NET",
      "desc": "MPU-6050 I2C legal bundle mapping: accept one complete legal STM32F427 hardware I2C SDA/SCL pair to the IMU. This forbids illegal mixed mappings such as PB7 for SDA together with PB8 for SCL.",
      "params": {
        "net_group_candidates": [
          {
            "label": "I2C1_DEFAULT",
            "pin_groups_list": [
              [["U3.PB7"], ["U4.SDA"]],
              [["U3.PB6"], ["U4.SCL"]]
            ]
          },
          {
            "label": "I2C1_ALT",
            "pin_groups_list": [
              [["U3.PB9"], ["U4.SDA"]],
              [["U3.PB8"], ["U4.SCL"]]
            ]
          },
          {
            "label": "I2C2",
            "pin_groups_list": [
              [["U3.PB11"], ["U4.SDA"]],
              [["U3.PB10"], ["U4.SCL"]]
            ]
          },
          {
            "label": "I2C3_STANDARD",
            "pin_groups_list": [
              [["U3.PC9"], ["U4.SDA"]],
              [["U3.PA8"], ["U4.SCL"]]
            ]
          },
          {
            "label": "I2C3_ALT_SDA_PB4",
            "pin_groups_list": [
              [["U3.PB4"], ["U4.SDA"]],
              [["U3.PA8"], ["U4.SCL"]]
            ]
          }
        ]
      }
    },
    {
      "id": "T3-1-C01-007",
      "check": "SAME_NET",
      "desc": "MPU-6050 is configured for I2C mode by tying CS to its supply rail.",
      "params": {
        "pins": [
          "U4.CS",
          "U4.VDD"
        ]
      }
    },
    {
      "id": "T3-1-C01-008",
      "check": "SAME_NET",
      "desc": "Shared SPI legal bundle mapping: accept one complete legal STM32F427 SPI1 routing bundle for SCK/MOSI/MISO to both BMP280 and W25Q128JV. This forbids illegal mixed mappings such as PA5 for SCK together with PB5 for MOSI.",
      "params": {
        "net_group_candidates": [
          {
            "label": "SPI1_DEFAULT",
            "pin_groups_list": [
              [["U3.PA5"], ["U5.SCK"], ["U6.CLK"]],
              [["U3.PA7"], ["U5.SDI"], ["U6.DI"]],
              [["U3.PA6"], ["U5.SDO"], ["U6.DO"]]
            ]
          },
          {
            "label": "SPI1_ALT",
            "pin_groups_list": [
              [["U3.PB3"], ["U5.SCK"], ["U6.CLK"]],
              [["U3.PB5"], ["U5.SDI"], ["U6.DI"]],
              [["U3.PB4"], ["U5.SDO"], ["U6.DO"]]
            ]
          }
        ]
      }
    },
    {
      "id": "T3-1-C01-011",
      "check": "SAME_NET",
      "desc": "BMP280 has an independent chip-select from one legal STM32F427 control pin.",
      "params": {
        "pin_groups": [
          [
            "U3.PA4",
            "U3.PA15",
            "U3.PB0",
            "U3.PB1"
          ],
          [
            "U5.CSB"
          ]
        ]
      }
    },
    {
      "id": "T3-1-C01-012",
      "check": "SAME_NET",
      "desc": "W25Q128JV flash has an independent chip-select from one legal STM32F427 control pin.",
      "params": {
        "pin_groups": [
          [
            "U3.PA4",
            "U3.PA15",
            "U3.PB0",
            "U3.PB1"
          ],
