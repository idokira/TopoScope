{
  "design_id": "T2-4",
  "tier": 2,
  "type": "COM",
  "description": "CAN bus node. STM32F103 communicates with MCP2515 standalone CAN controller via SPI1. MCP2515 connects to SN65HVD230 CAN transceiver (TXCAN->D, RXCAN->R). SN65HVD230 drives CAN_H/CAN_L differential bus with 120ohm termination. MCP2515 INT->STM32 PA3. Both STM32 and MCP2515 have 8MHz crystals. AMS1117-3.3 provides 3.3V from 5V input.",
  "ic_list": [
    "AMS1117-3.3 (U1)",
    "STM32F103xB (U2)",
    "MCP2515 (U3)",
    "SN65HVD230 (U4)"
  ],
  "verification_assertions": [
    {
      "id": "T2-4-C01-001",
      "check": "SAME_NET",
      "desc": "GND unification: all ground pins across 4 ICs share one common ground net.",
      "params": {
        "pins": [
          "U1.ADJ",
          "U2.VSS_1",
          "U2.VSS_2",
          "U2.VSS_3",
          "U2.VSSA",
          "U3.VSS",
          "U4.GND"
        ]
      }
    },
    {
      "id": "T2-4-C01-002",
      "check": "SAME_NET",
      "desc": "3.3V domain unification: LDO output, MCU core/analog/battery supply, CAN controller VDD, and transceiver VCC share one power net.",
      "params": {
        "pins": [
          "U1.VOUT",
          "U2.VDD_1",
          "U2.VDD_2",
          "U2.VDD_3",
          "U2.VDDA",
          "U2.VBAT",
          "U3.VDD",
          "U4.VCC"
        ]
      }
    },
    {
      "id": "T2-4-I02-001",
      "check": "NET_GROUP_ISOLATION",
      "desc": "Critical pin isolation: GND, VCC, VIN, SPI bundle lines (SCK/MOSI/MISO/CS), CAN logic (TXCAN/RXCAN), CAN differential (CANH/CANL), STM32 crystal (OSC_IN/OUT), MCP2515 crystal (OSC1/OSC2), and NRST must all be on mutually distinct nets. SPI isolation is anchored on MCP2515-side pins so it is invariant to STM32 SPI1 default/remap selection.",
      "params": {
        "groups": [
          ["U1.ADJ"],
          ["U1.VOUT"],
          ["U1.VIN"],
          ["U3.SCK"],
          ["U3.SI"],
          ["U3.SO"],
          ["U3.CS"],
          ["U3.TXCAN"],
          ["U3.RXCAN"],
          ["U4.CANH"],
          ["U4.CANL"],
          ["U2.OSC_IN"],
          ["U2.OSC_OUT"],
          ["U3.OSC1"],
          ["U3.OSC2"],
          ["U2.NRST"]
        ]
      }
    },
    {
      "id": "T2-4-C02-001",
      "check": "CONNECTED_TO_GROUND",
      "desc": "Unified ground net must carry Ground electrical attribute.",
      "params": {
        "pin": "U1.ADJ"
      }
    },
    {
      "id": "T2-4-C03-001",
      "check": "CONNECTED_TO_POWER",
      "desc": "3.3V rail must carry Power electrical attribute.",
      "params": {
        "pin": "U1.VOUT"
      }
    },
    {
      "id": "T2-4-C03-002",
      "check": "CONNECTED_TO_POWER",
      "desc": "5V input rail must carry Power electrical attribute.",
      "params": {
        "pin": "U1.VIN"
      }
    },
    {
      "id": "T2-4-C01-003",
      "check": "SAME_NET",
      "desc": "SPI1 legal bundle mapping: accept one complete legal STM32F103 SPI1 routing bundle to MCP2515, either default pins or remapped pins. This forbids illegal mixed mappings such as PA5 for SCK together with PB5 for MOSI.",
      "params": {
        "net_group_candidates": [
          {
            "label": "SPI1_DEFAULT",
            "pin_groups_list": [
              [["U2.PA5"], ["U3.SCK"]],
              [["U2.PA7"], ["U3.SI"]],
              [["U2.PA6"], ["U3.SO"]],
              [["U2.PA4"], ["U3.CS"]]
            ]
          },
          {
            "label": "SPI1_REMAP",
            "pin_groups_list": [
              [["U2.PB3"], ["U3.SCK"]],
              [["U2.PB5"], ["U3.SI"]],
              [["U2.PB4"], ["U3.SO"]],
              [["U2.PA15"], ["U3.CS"]]
            ]
          }
        ]
      }
    },
    {
      "id": "T2-4-C01-007",
      "check": "SAME_NET",
      "desc": "MCP2515 INT output connects to STM32 PA3.",
      "params": {
        "pins": ["U2.PA3", "U3.INT"]
      }
    },
    {
      "id": "T2-4-C01-008",
      "check": "SAME_NET",
      "desc": "CAN TX logic: MCP2515 TXCAN connects to SN65HVD230 D input.",
      "params": {
        "pins": ["U3.TXCAN", "U4.D"]
      }
    },
    {
      "id": "T2-4-C01-009",
      "check": "SAME_NET",
      "desc": "CAN RX logic: MCP2515 RXCAN connects to SN65HVD230 R output.",
      "params": {
        "pins": ["U3.RXCAN", "U4.R"]
      }
    },
    {
      "id": "T2-4-I01-001",
      "check": "NOT_SAME_NET",
      "desc": "BOOT0 must not be tied to VDD; forces bootloader mode instead of normal flash boot.",
      "params": {
        "pins": ["U2.BOOT0", "U2.VDD_1"]
      }
    },
    {
      "id": "T2-4-ANY-001",
      "type": "ANY_OF",
      "desc": "BOOT0 grounding policy: direct tie to GND or pull-down resistor to GND.",
      "conditions": [
        {
          "check": "SAME_NET",
          "params": {
            "pins": ["U2.BOOT0", "U2.VSS_1"]
          }
        },
        {
          "check": "EXISTS_PATH",
          "params": {
            "from_pin": "U2.BOOT0",
            "destination": "U2.VSS_1",
            "max_hops": 6,
            "allowed_components": ["Resistor"]
          }
        }
      ]
    },
    {
      "id": "T2-4-I01-002",
      "check": "NOT_SAME_NET",
      "desc": "MCP2515 RESET must not be tied to GND; permanent reset locks out CAN controller.",
      "params": {
        "pins": ["U3.RESET", "U3.VSS"]
      }
    },
    {
      "id": "T2-4-ANY-002",
      "type": "ANY_OF",
      "desc": "MCP2515 RESET must be held inactive: direct tie to VDD or external pull-up to power.",
      "conditions": [
        {
          "check": "SAME_NET",
          "params": {
            "pins": ["U3.RESET", "U1.VOUT"]
          }
        },
        {
          "check": "HAS_PULLUP_TO_POWER",
          "params": {
            "pin": "U3.RESET"
          }
        }
      ]
    },
    {
      "id": "T2-4-ANY-003",
      "type": "ANY_OF",
      "desc": "SN65HVD230 RS must select normal or slope-control mode: direct tie to GND or resistor to GND. High-impedance or VDD would force standby mode.",
      "conditions": [
        {
          "check": "SAME_NET",
          "params": {
            "pins": ["U4.RS", "U4.GND"]
          }
        },
        {
          "check": "EXISTS_PATH",
          "params": {
            "from_pin": "U4.RS",
            "destination": "U4.GND",
            "max_hops": 6,
            "allowed_components": ["Resistor"]
          }
        }
      ]
    },
    {
      "id": "T2-4-I03-001",
      "check": "PIN_NOT_ON_NET_WITH",
      "desc": "Anti-bypass: prevent LLM from skipping MCP2515 by wiring any STM32 SPI1 candidate pin directly to transceiver logic input.",
      "params": {
        "pin": "U4.D",
        "forbidden_pins": [
          "U2.PA5",
          "U2.PA7",
          "U2.PA6",
          "U2.PA4",
          "U2.PB3",
          "U2.PB5",
          "U2.PB4",
          "U2.PA15"
        ]
      }
    },
    {
      "id": "T2-4-I03-002",
      "check": "PIN_NOT_ON_NET_WITH",
      "desc": "Anti-bypass: prevent LLM from connecting any STM32 SPI1 candidate pin directly to CAN differential bus.",
      "params": {
        "pin": "U4.CANH",
        "forbidden_pins": [
          "U2.PA5",
          "U2.PA7",
          "U2.PA6",
          "U2.PA4",
          "U2.PB3",
          "U2.PB5",
          "U2.PB4",
          "U2.PA15"
        ]
      }
    },
    {
      "id": "T2-4-T11-001",
      "check": "HAS_BUS_TERMINATION",
      "desc": "CAN differential bus requires 120ohm termination resistor between CANH and CANL.",
      "params": {
        "pin_p": "U4.CANH",
        "pin_n": "U4.CANL",
        "resistance_range": "100-140"
      }
    },
    {
      "id": "T2-4-T12-001",
      "check": "HAS_DECOUPLING_NETWORK",
      "desc": "STM32 NRST requires RC reset topology: pull-up resistor to power plus filter capacitor to ground.",
      "params": {
        "pin": "U2.NRST",
        "require_pullup_to_power": true,
        "require_cap_to_ground": true
      }
    },
    {
      "id": "T2-4-T05-001",
      "check": "HAS_CRYSTAL_PAIR",
      "desc": "STM32 HSE 8MHz crystal on OSC_IN/OSC_OUT with load capacitors to ground.",
      "params": {
        "pin_osc_in": "U2.OSC_IN",
        "pin_osc_out": "U2.OSC_OUT"
      }
    },
    {
      "id": "T2-4-T05-002",
      "check": "HAS_CRYSTAL_PAIR",
      "desc": "MCP2515 8MHz crystal on OSC1/OSC2 with load capacitors to ground.",
      "params": {
        "pin_osc_in": "U3.OSC1",
        "pin_osc_out": "U3.OSC2"
      }
    },
    {
      "id": "T2-4-T01-001",
      "check": "HAS_CAP_TO_GROUND",
      "desc": "LDO input rail (VIN) must have bypass capacitor to ground.",
      "params": {
        "pin": "U1.VIN"
      }
    },
    {
      "id": "T2-4-T01-002",
      "check": "HAS_CAP_TO_GROUND",
      "desc": "3.3V domain must have decoupling capacitor to ground. One T01 covers the unified rail.",
      "params": {
        "pin": "U2.VDD_1"
      }
    }
  ],
  "assertion_summary": {
    "total": 23,
    "by_category": {
      "SAME_NET": 6,
      "NET_GROUP_ISOLATION": 1,
      "CONNECTED_TO_GROUND": 1,
      "CONNECTED_TO_POWER": 2,
      "NOT_SAME_NET": 2,
      "ANY_OF": 3,
      "PIN_NOT_ON_NET_WITH": 2,
      "HAS_BUS_TERMINATION": 1,
      "HAS_DECOUPLING_NETWORK": 1,
      "HAS_CRYSTAL_PAIR": 2,
      "HAS_CAP_TO_GROUND": 2
    }
  }
}