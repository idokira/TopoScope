      {
        "type": "Module",
        "name": "led_driver",
        "description": "PT4115 high-power LED constant-current driver. Buck topology converts VIN_12_24V to regulated LED current. SW pin drives external inductor and Schottky diode to LED cathode. CSN pin senses current via external sense resistor to GND for 350mA regulation. DIM pin accepts analog/PWM dimming control (0-250kHz, 0-2.5V analog or logic level). EP (exposed pad) must be soldered to large copper area for thermal dissipation and electrical GND connection. LED anode connects to VIN_12_24V; LED cathode returns through inductor/SW node. Current sense resistor value sets output current: Rcs = 0.1V / Iled = 0.285 ohm for 350mA.",
        "id": "led_driver"
      },
      {
        "type": "Component",
        "refdes": "U1",
        "part_number": "PT4115",
        "description": "High-power LED constant-current driver",
        "id": "U1"
      },
      {
        "type": "Pin",
        "name": "SW",
        "pin_number": "1",
        "electrical_type": "PowerOut",
        "description": "Drain of internal N-Ch MOSFET power switch. When ON, SW is pulled to GND internally. Connects to inductor and freewheeling diode anode.",
        "id": "U1_Pin1"
      },
      {
        "type": "Pin",
        "name": "GND",
        "pin_number": "2",
        "electrical_type": "Ground",
        "description": "Power and signal ground. Connect directly to ground plane.",
        "id": "U1_Pin2"
      },
      {
        "type": "Pin",
        "name": "DIM",
        "pin_number": "3",
        "electrical_type": "Input",
        "description": "Dimming control input. Internal 1.2M pull-up to 5V, can float for always-on. DC 0.5-2.5V for analog dimming. Below 0.3V forces shutdown (60uA quiescent). PWM dimming 100Hz-20kHz supported.",
        "id": "U1_Pin3"
      },
      {
        "type": "Pin",
        "name": "CSN",
        "pin_number": "4",
        "electrical_type": "AnalogIn",
        "description": "High-side current sense input. Connect sense resistor between VIN and CSN. IC measures (VIN - VCSN) to regulate LED current. ILED = 100mV / Rs.",
        "id": "U1_Pin4"
      },
      {
        "type": "Pin",
        "name": "VIN",
        "pin_number": "5",
        "electrical_type": "PowerIn",
        "description": "Power supply input, 6V to 30V. Requires low-ESR bypass capacitor (>=4.7uF).",
        "id": "U1_Pin5"
      },
      {
        "type": "Pin",
        "name": "EP",
        "pin_number": "PAD",
        "electrical_type": "Ground",
        "description": "Exposed thermal pad, internally connected to GND. Must be soldered to PCB ground plane for thermal dissipation.",
        "id": "U1_PinPAD"
      },
      {
        "type": "Module",
        "name": "dimming_control",
        "description": "Dimming control interface for PT4115 DIM pin. Provides analog voltage 0-2.5V or PWM signal 0-100% duty at 0-250kHz to regulate LED brightness. If unused, DIM pulled up to internal reference for full brightness; pull to GND for shutdown. This module represents the external control source or potentiometer/PWM generator interface.",
        "id": "dimming_control"
      },
      {
        "type": "Module",
        "name": "led_load",
        "description": "1W LED load at 350mA constant current. LED anode connects to VIN_12_24V. LED cathode connects to inductor/SW switching node through PT4115. Current returns through sense resistor to GND for regulation feedback. Forward voltage approximately 3.0-3.5V depending on LED color/temperature.",
        "id": "led_load"
      },
      {
        "type": "Module",
        "name": "current_sense",
        "description": "Current sense network for PT4115 CSN pin. Low-side shunt resistor between LED return path and GND develops voltage proportional to LED current. CSN pin senses this voltage; regulation loop maintains 100mV across sense resistor for constant current. For 350mA, R = 0.285 ohm. Sense resistor needs Kelvin connection or tight layout to CSN pin.",
        "id": "current_sense"
      },
