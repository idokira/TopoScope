        "pin_number": "3",
        "electrical_type": "PowerIn",
        "description": "Input power supply",
        "id": "U1_Pin3"
      },
      {
        "type": "Module",
        "name": "power_supervisor",
        "description": "TPS3703 supervises the regulated 3.3V rail and asserts a POWER_GOOD status output derived from the monitored rail condition. This module is powered from VCC_3V3 and senses the same VCC_3V3 node through its VDD and SENSE-related monitoring path so the supervision threshold applies to the actual regulated output rail. RESET is used as the exported status signal and is exposed semantically as POWER_GOOD for downstream system use. CT and MR require later configuration/support intent: CT sets timing behavior through an external network added downstream, and MR must be placed in a defined non-asserting state if no external manual reset source is provided. If RESET output structure requires pull-up or bias ownership, that support circuitry is added later in this module.",
        "id": "power_supervisor"
      },
      {
        "type": "Component",
        "refdes": "U2",
        "part_number": "TPS3703",
        "description": "Voltage supervisor / reset generator",
