        "id": "U1_Pin3"
      },
      {
        "type": "Module",
        "name": "power_monitor",
        "description": "TPS3703 voltage supervisor monitors VCC_3V3 rail and provides POWER_GOOD status via RESET pin. VDD pin powered from VIN_5V global rail to ensure supervisor operates during LDO startup and fault conditions. SENSE pin monitors VCC_3V3 for undervoltage detection. Appropriate threshold variant required for 3.3V monitoring. CT pin configures reset timeout delay (capacitor to GND). MR pin (manual reset) left unconnected or tied to VDD for normal operation. RESET pin is open-drain output (active-low) and requires external pull-up resistor; when VCC_3V3 is within threshold, RESET is high (power good); when below threshold, RESET is low (power bad).",
        "id": "power_monitor"
      },
      {
        "type": "Component",
        "refdes": "U2",
        "part_number": "TPS3703",
        "description": "Voltage supervisor / reset generator",
        "id": "U2"
      },
      {
        "type": "Pin",
        "name": "SENSE",
        "pin_number": "1",
        "electrical_type": "AnalogIn",
        "description": "Monitored voltage input. Internal resistor divider sets OV/UV thresholds. Connect to VDD if monitoring VDD directly.",
        "id": "U2_Pin1"
      },
      {
        "type": "Pin",
        "name": "VDD",
        "pin_number": "2",
        "electrical_type": "PowerIn",
        "description": "Supply voltage 1.7-5.5V. Optional 0.1-1uF bypass cap to GND for noisy supplies.",
        "id": "U2_Pin2"
      },
      {
        "type": "Pin",
        "name": "CT",
        "pin_number": "3",
        "electrical_type": "Passive",
        "description": "Delay time programming. Open=short delay, 10K to VDD=long delay, cap to GND=programmable, GND=latch mode.",
        "id": "U2_Pin3"
      },
      {
        "type": "Pin",
        "name": "RESET",
