{
  "design_id": "T3-4",
  "tier": 3,
  "type": "AUD",
  "description": "Stereo audio playback system. USB_5V powers PAM8403 directly and feeds AMS1117-3.3 for ATmega328P and MCP4725. MT3608 boosts USB_5V to a 9V analog rail only for the NE5532 preamplifier stage. ATmega328P controls MCP4725 over I2C. MCP4725 VOUT provides a shared GAIN_CTRL / bias-control signal to the NE5532 stereo preamp. NE5532 left/right outputs feed PAM8403 left/right inputs, and PAM8403 drives stereo speaker outputs. Common GND is used with analog/digital star-ground intent. A complete voltage-controlled gain circuit is not required.",
  "ic_list": [
    "MT3608 (U1)",
    "AMS1117-3.3 (U2)",
    "ATmega328P (U3)",
    "MCP4725 (U4)",
    "NE5532 (U5)",
    "PAM8403 (U6)"
  ],
  "verification_assertions": [
    {
      "id": "T3-4-C01-001",
      "check": "SAME_NET",
      "desc": "Common ground: boost converter, LDO, MCU, DAC, NE5532 negative supply, and PAM8403 grounds share common GND with star-ground layout intent.",
      "params": {
        "pins": [
          "U1.GND",
          "U2.GND",
          "U3.GND",
          "U3.GND_2",
          "U4.VSS",
          "U5.VCC_N",
          "U6.GND",
          "U6.PGND_1",
          "U6.PGND_2"
        ]
      }
    },
    {
      "id": "T3-4-C01-002",
      "check": "SAME_NET",
      "desc": "USB_5V input rail powers MT3608 input, AMS1117 input, and PAM8403 5V supply pins.",
      "params": {
        "pins": [
          "U1.VIN",
          "U2.VIN",
          "U6.PVDD_1",
          "U6.PVDD_2",
          "U6.VDD"
        ]
      }
    },
