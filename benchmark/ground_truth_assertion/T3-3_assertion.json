{
  "design_id": "T3-3",
  "tier": 3,
  "type": "DRV",
  "description": "Dual stepper motor controller. A 12V-24V motor input feeds TPS54331 to generate 5V, and AMS1117-3.3 generates 3.3V logic power. STM32F103 controls two TMC2209 stepper drivers through independent STEP/DIR/ENN signals. The two TMC2209 drivers share a UART configuration bus but use different address/configuration pin states. STM32F103 also connects to W25Q64JV Flash via SPI. Motor supply and logic supply are separate rails but share common GND; no galvanic isolation is required.",
  "ic_list": [
    "TPS54331 (U1)",
    "AMS1117-3.3 (U2)",
    "STM32F103 (U3)",
    "TMC2209 channel A (U4)",
    "TMC2209 channel B (U5)",
    "W25Q64JV (U6)"
  ],
  "verification_assertions": [
    {
      "id": "T3-3-C01-001",
      "check": "SAME_NET",
      "desc": "Common ground: buck, LDO, STM32, both TMC2209 drivers, and flash share common GND.",
      "params": {
        "pins": [
          "U1.GND",
          "U2.GND",
          "U3.VSS_1",
          "U3.VSS_2",
          "U3.VSS_3",
          "U3.VSSA",
          "U4.GND_1",
          "U4.GND_2",
          "U4.EP",
          "U5.GND_1",
          "U5.GND_2",
          "U5.EP",
          "U6.GND"
        ]
      }
    },
    {
