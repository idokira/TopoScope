{
  "design_id": "T2-7",
  "tier": 2,
  "type": "DRV",
  "description": "Single-channel DC motor driver with low-side current sense feedback. STM32F103 controls TB6612FNG channel A via AIN1/AIN2/PWMA/STBY. TB6612 motor return passes through a low-side shunt resistor to common GND. INA128 senses the two shunt terminals and outputs to an STM32 ADC. VIN_MOTOR is the external motor rail. VIN_5V feeds AMS1117-3.3, which provides VCC_3V3 for STM32, TB6612 logic, and INA128.",
  "ic_list": [
    "AMS1117-3.3 (U1)",
    "STM32F103 (U2)",
    "TB6612FNG (U3)",
    "INA128 (U4)"
  ],
  "verification_assertions": [
    {
      "id": "T2-7-C01-001",
      "check": "SAME_NET",
      "desc": "Common logic ground: LDO ground, STM32 grounds, TB6612 logic GND, INA128 V_NEG, and INA128 REF share common system GND. TB6612 PGND pins are intentionally excluded because low-side shunt sensing places them on the motor-return side of the shunt.",
      "params": {
        "pins": [
          "U1.GND",
          "U2.VSS_1",
          "U2.VSS_2",
          "U2.VSS_3",
          "U2.VSSA",
          "U3.GND",
          "U4.V_NEG",
          "U4.REF"
        ]
      }
    },
    {
      "id": "T2-7-C01-002",
      "check": "SAME_NET",
      "desc": "3.3V logic rail: AMS1117 output powers STM32, TB6612 logic VCC, and INA128 positive supply.",
      "params": {
        "pins": [
          "U1.VOUT",
          "U2.VDD_1",
          "U2.VDD_2",
          "U2.VDD_3",
          "U2.VDDA",
