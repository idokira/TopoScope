    },
    {
      "id": "T3-1-I02-001",
      "check": "NET_GROUP_ISOLATION",
      "desc": "Critical power and switching domains must remain distinct: 5V input, digital 3.3V, analog/sensor 3.3V, GND, TPS54331 switch node, TPS54331 feedback node, I2C SDA, I2C SCL, SPI SCK, SPI MOSI, SPI MISO, BMP280 CS, and Flash CS. Bus-related isolation is anchored on peripheral-side pins so it is invariant to STM32 pin selection.",
      "params": {
        "groups": [
          ["U1.VIN"],
          ["U6.VCC"],
          ["U2.VOUT"],
          ["U1.GND"],
          ["U1.PH"],
          ["U1.VSENSE"],
          ["U4.SDA"],
          ["U4.SCL"],
          ["U5.SCK"],
          ["U5.SDI"],
          ["U5.SDO"],
          ["U5.CSB"],
          ["U6.CS"]
        ]
      }
    },
