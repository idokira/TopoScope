{
  "design_id": "T2-8",
  "tier": 2,
  "type": "AUD",
  "description": "Single-channel audio preamplifier with DAC control interface. ATmega328P controls MCP4725 DAC via I2C. MCP4725 VOUT provides an analog control/bias signal to NE5532 channel 1 non-inverting input network. NE5532 channel 1 is the active audio amplifier path; channel 2 is unused and tied to a safe state. VIN_5V powers the analog stage, and AMS1117-3.3 provides 3.3V for ATmega328P and MCP4725. Common GND is used.",
  "ic_list": [
    "AMS1117-3.3 (U1)",
    "ATmega328P (U2)",
    "MCP4725 (U3)",
    "NE5532 (U4)"
  ],
  "verification_assertions": [
    {
      "id": "T2-8-C01-001",
      "check": "SAME_NET",
      "desc": "Common ground: LDO ground, ATmega ground, MCP4725 ground, and NE5532 negative supply share common GND.",
      "params": {
        "pins": [
          "U1.GND",
          "U2.GND",
          "U2.GND_2",
          "U3.VSS",
          "U4.VCC_N"
        ]
      }
    },
    {
      "id": "T2-8-C01-002",
      "check": "SAME_NET",
      "desc": "3.3V digital rail: AMS1117 output powers ATmega328P and MCP4725.",
      "params": {
        "pins": [
          "U1.VOUT",
          "U2.VCC",
          "U2.AVCC",
          "U3.VDD"
        ]
      }
    },
    {
      "id": "T2-8-C01-003",
      "check": "SAME_NET",
      "desc": "Analog supply: VIN_5V input powers NE5532 positive supply.",
      "params": {
        "pins": [
          "U1.VIN",
          "U4.VCC_P"
        ]
      }
    },
    {
      "id": "T2-8-C01-004",
      "check": "SAME_NET",
      "desc": "I2C SDA: ATmega328P hardware TWI SDA pin PC4 connects to MCP4725 SDA.",
      "params": {
        "pins": [
          "U2.PC4",
          "U3.SDA"
        ]
      }
    },
    {
      "id": "T2-8-C01-005",
      "check": "SAME_NET",
      "desc": "I2C SCL: ATmega328P hardware TWI SCL pin PC5 connects to MCP4725 SCL.",
      "params": {
        "pins": [
          "U2.PC5",
          "U3.SCL"
        ]
      }
    },
    {
      "id": "T2-8-I02-001",
      "check": "NET_GROUP_ISOLATION",
      "desc": "Critical node isolation: VIN_5V analog rail, VCC_3V3 digital rail, GND, I2C SDA, I2C SCL, DAC/control node, NE5532 channel-1 output, and NE5532 channel-1 inverting input must remain distinct. I2C isolation is anchored on MCP4725-side bus pins for semantic stability.",
      "params": {
        "groups": [
          [
            "U1.VIN"
          ],
          [
            "U1.VOUT"
          ],
          [
            "U1.GND"
          ],
          [
            "U3.SDA"
          ],
          [
            "U3.SCL"
          ],
          [
            "U3.VOUT"
          ],
          [
            "U4.OUT1"
          ],
          [
            "U4.IN1_N"
          ]
        ]
      }
    },
    {
      "id": "T2-8-C02-001",
      "check": "CONNECTED_TO_GROUND",
      "desc": "Common ground net must carry Ground electrical attribute.",
      "params": {
        "pin": "U1.GND"
      }
    },
    {
      "id": "T2-8-C03-001",
      "check": "CONNECTED_TO_POWER",
      "desc": "3.3V digital rail must carry Power electrical attribute.",
      "params": {
        "pin": "U1.VOUT"
      }
    },
    {
      "id": "T2-8-C03-002",
      "check": "CONNECTED_TO_POWER",
      "desc": "VIN_5V analog rail must carry Power electrical attribute.",
      "params": {
        "pin": "U1.VIN"
      }
    },
    {
      "id": "T2-8-ANY-001",
      "type": "ANY_OF",
      "desc": "MCP4725 A0 must select I2C address: tie to GND for 0x60 or VDD for 0x61.",
      "conditions": [
        {
          "check": "CONNECTED_TO_GROUND",
          "params": {
            "pin": "U3.A0"
          }
        },
        {
          "check": "CONNECTED_TO_POWER",
          "params": {
            "pin": "U3.A0"
          }
        }
      ]
    },
    {
      "id": "T2-8-ANY-002",
      "type": "ANY_OF",
      "desc": "DAC output reaches the NE5532 channel-1 non-inverting input/control node, either directly or through a resistor network.",
      "conditions": [
        {
          "check": "SAME_NET",
          "params": {
            "pins": [
              "U3.VOUT",
              "U4.IN1_P"
            ]
          }
        },
        {
          "check": "EXISTS_PATH",
          "params": {
            "from_pin": "U3.VOUT",
            "destination": "U4.IN1_P",
            "max_hops": 4,
            "allowed_components": [
              "Resistor"
            ]
          }
        }
      ]
    },
    {
      "id": "T2-8-ANY-003",
      "type": "ANY_OF",
      "desc": "NE5532 channel-2 is either safely tied off as unused, or configured as a safe local buffer for the DAC bias/control node.",
      "conditions": [
        {
          "check": "SAME_NET",
          "params": {
            "pins": [
              "U4.IN2_P",
              "U4.IN2_N",
              "U1.GND"
            ]
          }
        },
        {
          "type": "AND_GROUP",
          "conditions": [
            {
              "check": "SAME_NET",
              "params": {
                "pins": [
                  "U4.IN2_N",
                  "U4.OUT2"
                ]
              }
            },
            {
              "check": "SAME_NET",
              "params": {
                "pins": [
                  "U4.IN2_P",
                  "U3.VOUT"
                ]
              }
            }
          ]
        },
        {
          "type": "AND_GROUP",
          "conditions": [
            {
              "check": "SAME_NET",
              "params": {
                "pins": [
                  "U4.IN2_N",
                  "U4.OUT2"
                ]
              }
            },
            {
              "check": "EXISTS_PATH",
              "params": {
                "from_pin": "U3.VOUT",
                "destination": "U4.IN2_P",
                "max_hops": 4,
                "allowed_components": [
                  "Resistor"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "id": "T2-8-T06-001",
      "check": "HAS_PULLUP_TO_POWER",
      "desc": "I2C SDA line requires pull-up resistor to power. Anchored on MCP4725 SDA so the assertion targets the bus itself.",
      "params": {
        "pin": "U3.SDA"
      }
    },
    {
      "id": "T2-8-T06-002",
      "check": "HAS_PULLUP_TO_POWER",
      "desc": "I2C SCL line requires pull-up resistor to power. Anchored on MCP4725 SCL so the assertion targets the bus itself.",
      "params": {
        "pin": "U3.SCL"
      }
    },
    {
      "id": "T2-8-T01-001",
      "check": "HAS_CAP_TO_GROUND",
      "desc": "VIN_5V analog rail must have bypass capacitor to ground.",
      "params": {
        "pin": "U1.VIN"
      }
    },
    {
      "id": "T2-8-T01-002",
      "check": "HAS_CAP_TO_GROUND",
      "desc": "3.3V digital rail must have decoupling capacitor to ground.",
      "params": {
        "pin": "U2.VCC"
      }
    }
  ],
  "assertion_summary": {
    "total": 16,
    "by_category": {
      "SAME_NET": 5,
      "NET_GROUP_ISOLATION": 1,
      "CONNECTED_TO_GROUND": 1,
      "CONNECTED_TO_POWER": 2,
      "ANY_OF": 3,
      "HAS_PULLUP_TO_POWER": 2,
      "HAS_CAP_TO_GROUND": 2
    }
  }
}