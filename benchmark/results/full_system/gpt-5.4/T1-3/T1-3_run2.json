      },
      {
        "type": "Module",
        "name": "led_driver",
        "description": "PT4115-based buck constant-current LED driver for a 1W LED load from the external VIN_12V_24V rail. This module converts the input supply into a controlled LED current path and owns the switching node, current-sense feedback path, dimming control intent, and LED load interface. VIN is powered directly from the global input rail and GND/EP return to the common ground. SW connects to the external power-stage path that routes through the inductor/diode network to the LED output chain, while CSN observes the low-side current-sense node so downstream wiring can set the target LED current to 350 mA through the required passive sense network. DIM is exposed as a control input so the design can support external PWM or analog dimming; if no external dimming source is populated downstream, DIM should be biased for always-on operation. The LED current path is high-current and switching, so downstream implementation must keep the SW loop compact and route the CSN sense path as a quiet feedback connection separate from noisy switching return currents.",
        "id": "led_driver"
      },
      {
        "type": "Component",
        "refdes": "U1",
        "part_number": "PT4115",
        "description": "High-power LED constant-current driver",
        "id": "U1"
