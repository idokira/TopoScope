      },
      {
        "type": "Module",
        "name": "led_driver",
        "description": "PT4115-based buck LED constant-current driver that converts the external VIN_12V_24V rail into a regulated LED load current for a 1W LED target at 350mA. Major signal flow is VIN_12V_24V into the switching regulator, SW into the external inductor/diode/output current path, then through the LED load and current-sense network back to GND via CSN feedback. The module exposes the switched power node, the LED current output path, the current-sense feedback node, and the DIM control interface for optional analog or PWM dimming. DIM operating policy must be defined during downstream design; if no external dimming control is provided, DIM needs a deliberate default bias/enable strategy rather than being left undefined. CSN is the regulation feedback input and must observe the LED current sense node through the external shunt/passive network. SW is a high-current switching node and must remain confined to the power stage path. The exposed LED path and CSN feedback together preserve the required constant-current control topology without assigning passive parts in this phase.",
        "id": "led_driver"
      },
      {
        "type": "Component",
        "refdes": "U1",
        "part_number": "PT4115",
        "description": "High-power LED constant-current driver",
        "id": "U1"
      },
      {
        "type": "Pin",
        "name": "SW",
        "pin_number": "1",
        "electrical_type": "PowerOut",
        "description": "Drain of internal N-Ch MOSFET power switch. When ON, SW is pulled to GND internally. Connects to inductor and freewheeling diode anode.",
        "id": "U1_Pin1"
      },
      {
        "type": "Pin",
        "name": "GND",
        "pin_number": "2",
        "electrical_type": "Ground",
        "description": "Power and signal ground. Connect directly to ground plane.",
        "id": "U1_Pin2"
      },
      {
        "type": "Pin",
        "name": "DIM",
        "pin_number": "3",
        "electrical_type": "Input",
        "description": "Dimming control input. Internal 1.2M pull-up to 5V, can float for always-on. DC 0.5-2.5V for analog dimming. Below 0.3V forces shutdown (60uA quiescent). PWM dimming 100Hz-20kHz supported.",
        "id": "U1_Pin3"
      },
      {
        "type": "Pin",
        "name": "CSN",
        "pin_number": "4",
        "electrical_type": "AnalogIn",
        "description": "High-side current sense input. Connect sense resistor between VIN and CSN. IC measures (VIN - VCSN) to regulate LED current. ILED = 100mV / Rs.",
        "id": "U1_Pin4"
      },
      {
        "type": "Pin",
        "name": "VIN",
        "pin_number": "5",
        "electrical_type": "PowerIn",
        "description": "Power supply input, 6V to 30V. Requires low-ESR bypass capacitor (>=4.7uF).",
        "id": "U1_Pin5"
      },
      {
        "type": "Pin",
        "name": "EP",
        "pin_number": "PAD",
        "electrical_type": "Ground",
        "description": "Exposed thermal pad, internally connected to GND. Must be soldered to PCB ground plane for thermal dissipation.",
        "id": "U1_PinPAD"
      },
      {
        "type": "Module",
        "name": "led_load",
        "description": "High-power LED load domain representing the external 1W LED output path driven at a nominal 350mA constant current. This module receives the regulated LED current from the driver and returns through the current-sense path used by the PT4115 control loop. The LED anode/cathode implementation and any connector details are deferred to downstream design, but the macro plan preserves the mandatory series current path from the driver output through the LED and into the sense node. This module operates directly from the switching LED current path and shares common GND return through the low-side sense arrangement.",
        "id": "led_load"
      },
      {
        "type": "Module",
        "name": "dimming_control",
        "description": "Optional external dimming/control interface for the PT4115 DIM input. This module represents a board-level control entry point or default-bias intent for enabling and dimming the LED driver. Because no active controller or connector is provided in the component list, this module is planning-only and downstream implementation must realize DIM with an external control source or a fixed default network. It must drive the PT4115 DIM input with a defined logic/PWM/analog control state and must not be left floating.",
        "id": "dimming_control"
      },
